{
  "id": "vklive",
  "name": "VK Video Live",
  "api_version": 2,
  "module": "vklive.wasm",
  "capabilities": [
    "http",
    "chat",
    "audience",
    "failure",
    "panel",
    "channel",
    "status"
  ],
  "services": [
    "https://apidev.live.vkvideo.ru"
  ],
  "subscriptions": [],
  "settings": [
    {
      "id": "channel",
      "label": "Channel",
      "help": "Channel slug from live.vkvideo.ru, without the URL.",
      "max_length": 128
    }
  ],
  "secret_fields": {
    "access_token": "/access_token",
    "refresh_token": "/refresh_token"
  },
  "unique_viewers": false,
  "execution_side": "client"
}
