{
  "id": "youtube",
  "name": "YouTube",
  "api_version": 2,
  "module": "youtube.wasm",
  "capabilities": [
    "http",
    "chat",
    "audience",
    "delete",
    "delivery",
    "failure",
    "panel",
    "channel",
    "status"
  ],
  "services": [
    "https://www.googleapis.com"
  ],
  "subscriptions": [
    "chat.send"
  ],
  "settings": [
    {
      "id": "video_id",
      "label": "Video ID",
      "help": "ID from the YouTube watch URL. Leave empty to discover an active broadcast for the authorized account.",
      "max_length": 128
    }
  ],
  "secret_fields": {
    "access_token": "/access_token",
    "refresh_token": "/refresh_token"
  },
  "unique_viewers": false,
  "execution_side": "client"
}
